    "lines": [
      {
        "id": "mcgrot-01",
        "text": "Mingin? Come back when your own kitchen’s had a shift like mine.",
        "delivery": "[flaring, then calmer]"
      },
      {
        "id": "mcgrot-02",
        "text": "Do not call it scraps.",
        "delivery": "[offended, flat]"
      },
      {
        "id": "mcgrot-03",
        "text": "Naw.",
        "delivery": "[flat, immediate]"
      },
      {
        "id": "mcgrot-04",
        "text": "Awright pal. Sauce is extra, opinions are free.",
        "delivery": "[warning, then softening]"
      },
      {
        "id": "mcgrot-05",
        "text": "Steamboats or stone sober, my queue’s still the longest at the fit o’ the Walk.",
        "delivery": "[with weary pride]"
      },
      {
        "id": "mcgrot-06",
        "text": "Away and get your messages first — then tell me that’s shan.",
        "delivery": "[pointing with the spatula]"
      },
      {
        "id": "mcgrot-07",
        "text": "Pomplé says the sauce needs mercy, and I believe the dog.",
        "delivery": "[confidential, glancing down]"
      },
      {
        "id": "mcgrot-08",
        "text": "Persevere, it says on the bin. Persevere, I say back.",
        "delivery": "[reading the bin, then muttering]"
      },
      {
        "id": "mcgrot-09",
        "text": "Extra sauce, every time. That’s not negotiable, pal.",
        "delivery": "[flat, final]"
      },
      {
        "id": "mcgrot-10",
        "text": "Radge, the pair of you — queueing for a smell.",
        "delivery": "[unimpressed, stirring]"
      },
      {
        "id": "mcgrot-11",
        "text": "I’ve buried better plans than this under a layer of onions, ken.",
        "delivery": "[considering the pot]"
      },
      {
        "id": "mcgrot-12",
        "text": "Chum me doon the fit o’ the Walk and I’ll show ye a queue that means something.",
        "delivery": "[proud, already walking]"
      }
    ],
