.env.local*
node_modules/
dist/
src/dev-bundle.js
src/mcgrots-bundle.js
.DS_Store

# Cached full-size Commons downloads — intermediate only; the runtime uses
# assets/shopfronts/atlas.jpg. Kept locally so re-cropping never re-hits Wikimedia.
assets/shopfronts/raw/

# Façade pipeline intermediates: rectified planes, sliced band tiles, and the
# QA contact sheets. Only the finished atlas ships.
assets/shopfronts/rect/
assets/shopfronts/bands/
assets/shopfronts/qa/

# D4 façade v3 intermediates: raw AI generations (generated/) and the
# per-building graded elevations (elevations/, real-photo + AI, signage
# baked in) that scripts/build-elevation-atlas.mjs packs into atlas-pages/ —
# only the packed pages ship. Re-running gen-facade-elevations.mjs/
# apply-signage.mjs/build-elevation-atlas.mjs regenerates all three.
assets/shopfronts/generated/
assets/shopfronts/elevations/

# Site build output (published to the gh-pages branch)
dist-site/

# Smoke-rig evidence captures — regenerated on every run, never diffed.
# See the captureDir note in scripts/smoke.mjs.
docs/smoke/captures/

# Daily TTS harvest logs (scripts/daily-tts.sh)
scripts/.tts-logs/

# E8d image-to-3D candidates: generated character images (gen-character.mjs)
# and the glbs Trellis returns for them (gen-mesh.mjs). Each run costs money,
# so they are kept locally rather than re-generated — but only a JUDGED mesh
# earns a place in assets/, and nothing here is one yet.
scratchpad/
src/mcgrots-compare-bundle.js
src/mcgrots-flats-bundle.js
.herdr/

# G5e voice-audition rig (scripts/mcgrots-voice-audition.mjs): rendered
# candidate audio costs real money per call and is never committed — only
# manifest.json (engine, line, description, custom_voice_id, spend) is
# tracked, as the record of what was auditioned.
docs/voice-audition/*.mp3
docs/voice-audition/*.wav
docs/voice-audition/**/*.mp3
docs/voice-audition/**/*.wav

# G5g Drive pull staging (scripts/mcgrots-drive-pull.mjs): new comics land
# here first. Landing them in assets/comics/ + assets/catalog.json is a
# separate human milestone — see scripts/catalog-batches/BRIEF.md.
assets/comics-incoming/
